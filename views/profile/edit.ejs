<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="UTF-8">
    <title>Edit My Profile</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #dde2ea;
            font-family: 'Lucida Grande', 'Lucida Sans Unicode', Verdana, Arial, sans-serif;
            font-size: 13px;
            color: #000;
        }

        .main-container {
            display: flex;
            gap: 25px;
            max-width: 1150px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .sidebar-left {
            width: 200px;
            flex-shrink: 0;
        }

        .nav-links-box {
            border: 1px dashed #555555;
            padding: 12px;
            background: #fff;
        }

        .nav-links-box ul {
            list-style: none;
        }

        .nav-links-box ul li a {
            color: #5471b0;
            text-decoration: none;
            font-weight: 500;
        }

        .nav-links-box ul li a:hover {
            text-decoration: underline;
        }

        .profile-container {
            flex: 1;
            border: 2px solid #3b5998;
            background-color: #fff;
        }

        .profile-topbar {
            background: #4c66a4;
            padding: 8px 15px;
            border-bottom: 1px solid #3b5998;
            color: #fff;
            font-size: 15px;
            font-weight: bold;
        }

        .profile-body {
            display: flex;
            padding: 20px;
            gap: 20px;
        }

        .info-container {
            border: 1px solid #3b5998;
            width: 100%;
        }

        .info-box-hd {
            background: #6d84b4;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
            padding: 5px 12px;
        }

        .info-section {
            padding: 15px;
        }

        .info-section-title {
            font-weight: bold;
            font-size: 13px;
            color: #3b5998;
            margin: 10px 0 6px 0;
            border-bottom: 1px solid #6d84b4;
            padding-bottom: 2px;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .info-table td {
            padding: 5px 5px 5px 0;
            vertical-align: middle;
            font-size: 13px;
        }

        .info-table .lbl {
            color: #000;
            width: 150px;
            white-space: nowrap;
            font-weight: bold;
        }

        /* Retro text fields */
        .edit-input {
            width: 100%;
            max-width: 350px;
            height: 24px;
            border: 1px solid #7f9db9;
            padding: 2px 5px;
            font-size: 13px;
        }

        .edit-textarea {
            width: 100%;
            max-width: 500px;
            height: 80px;
            border: 1px solid #7f9db9;
            padding: 4px 5px;
            font-size: 13px;
            font-family: inherit;
            resize: vertical;
        }

        .btn-submit {
            background: #f0f0f0;
            border: 1px solid #7f9db9;
            padding: 4px 15px;
            font-size: 13px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-submit:hover {
            background: #e5e5e5;
        }
    </style>
</head>

<body>

    <%- include('../partials/nav') %>

        <div class="main-container">
            <div class="sidebar-left">
                <div class="nav-links-box">
                    <ul>
                        <li><a href="/profile">&laquo; Cancel Changes</a></li>
                    </ul>
                </div>
            </div>

            <div class="profile-container">
                <div class="profile-topbar">
                    Edit Profile Information
                </div>

                <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="profile-body"
                    style="flex-direction: column;">

                    <div class="info-container">
                        <div class="info-box-hd">Edit System Profile Context</div>
                        <div class="info-section">

                            <p class="info-section-title">Account Info:</p>
                            <table class="info-table">
                                <tr>
                                    <td class="lbl">Name:</td>
                                    <td><input type="text" name="fullName" class="edit-input"
                                            value="<%= profileUser.fullName || '' %>"></td>
                                </tr>
                            </table>

                            <p class="info-section-title">Access Context:</p>
                            <table class="info-table">
                                <tr>
                                    <td class="lbl">Access Location:</td>
                                    <td><input type="text" name="accessLocation" class="edit-input"
                                            value="<%= profileUser.accessLocation || '' %>"
                                            placeholder="non-residential location"></td>
                                </tr>
                            </table>

                            <p class="info-section-title">Basic Info:</p>
                            <table class="info-table">
                                <tr>
                                    <td class="lbl">School / College:</td>
                                    <td><input type="text" name="college" class="edit-input"
                                            value="<%= profileUser.college || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Status:</td>
                                    <td><input type="text" name="status" class="edit-input"
                                            value="<%= profileUser.status || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Sex:</td>
                                    <td><input type="text" name="sex" class="edit-input"
                                            value="<%= profileUser.sex || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Residence:</td>
                                    <td><input type="text" name="residence" class="edit-input"
                                            value="<%= profileUser.residence || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Birthday:</td>
                                    <td><input type="text" name="birthday" class="edit-input"
                                            value="<%= profileUser.birthday || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Home Town:</td>
                                    <td><input type="text" name="hometown" class="edit-input"
                                            value="<%= profileUser.hometown || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">High School:</td>
                                    <td><input type="text" name="highSchool" class="edit-input"
                                            value="<%= profileUser.highSchool || '' %>"></td>
                                </tr>
                            </table>

                            <p class="info-section-title">Contact Info:</p>
                            <table class="info-table">
                                <tr>
                                    <td class="lbl">Screenname:</td>
                                    <td><input type="text" name="screenname" class="edit-input"
                                            value="<%= profileUser.screenname || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Mobile:</td>
                                    <td><input type="text" name="mobile" class="edit-input"
                                            value="<%= profileUser.mobile || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Websites:</td>
                                    <td><textarea name="websites" class="edit-textarea"
                                            style="height: 50px;"><%= profileUser.websites || '' %></textarea></td>
                                </tr>
                            </table>

                            <p class="info-section-title">Personal Info:</p>
                            <table class="info-table">
                                <tr>
                                    <td class="lbl">Looking For:</td>
                                    <td><input type="text" name="lookingFor" class="edit-input"
                                            value="<%= profileUser.lookingFor || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Interested In:</td>
                                    <td><input type="text" name="interestedIn" class="edit-input"
                                            value="<%= profileUser.interestedIn || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Relationship Status:</td>
                                    <td><input type="text" name="relationshipStatus" class="edit-input"
                                            value="<%= profileUser.relationshipStatus || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Political Views:</td>
                                    <td><input type="text" name="politicalViews" class="edit-input"
                                            value="<%= profileUser.politicalViews || '' %>"></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Interests:</td>
                                    <td><textarea name="interests"
                                            class="edit-textarea"><%= profileUser.interests || '' %></textarea></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Favorite Music:</td>
                                    <td><textarea name="favoriteMusic"
                                            class="edit-textarea"><%= profileUser.favoriteMusic || '' %></textarea></td>
                                </tr>
                                <tr>
                                    <td class="lbl">Favorite Movies:</td>
                                    <td><textarea name="favoriteMovies"
                                            class="edit-textarea"><%= profileUser.favoriteMovies || '' %></textarea>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="lbl">About Me (Bio):</td>
                                    <td><textarea name="bio" class="edit-textarea"
                                            style="height: 100px;"><%= profileUser.bio || '' %></textarea></td>
                                </tr>
                            </table>

                            <div style="margin-top: 20px; text-align: right;">
                                <button type="submit" class="btn-submit">Save Profile Changes</button>
                            </div>

                        </div>
                    </div>

                </form>
            </div>
        </div>
</body>

</html>