<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Search Results – thefacebook</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #dde2ea;
            font-family: 'Lucida Grande', 'Lucida Sans Unicode', Verdana, Arial, sans-serif;
            font-size: 13px;
            color: #000;
        }

        .main-container {
            display: flex;
            gap: 25px;
            max-width: 1150px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .sidebar-left { width: 200px; flex-shrink: 0; }

        .nav-links-box {
            border: 1px dashed #555555;
            padding: 12px;
            background: #fff;
        }

        .nav-links-box ul { list-style: none; }
        .nav-links-box ul li { margin-bottom: 8px; }
        .nav-links-box ul li a { color: #5471b0; text-decoration: none; font-weight: 500; }
        .nav-links-box ul li a:hover { text-decoration: underline; }

        .profile-container {
            flex: 1;
            border: 2px solid #3b5998;
            background-color: #fff;
        }

        .profile-topbar {
            background: #4c66a4;
            padding: 8px 15px;
            border-bottom: 1px solid #3b5998;
            color: #fff;
            font-size: 15px;
            font-weight: bold;
        }

        .content-body { padding: 20px; }

        .search-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px dotted #6d84b4;
        }

        .search-card:last-child { border-bottom: none; }

        .res-avatar {
            width: 75px;
            height: 75px;
            object-fit: cover;
            border: 1px solid #bcbcbc;
            flex-shrink: 0;
        }

        .res-avatar-ph {
            width: 75px;
            height: 75px;
            background: #e0e4f0;
            border: 1px solid #bcbcbc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: bold;
            color: #3b5998;
            flex-shrink: 0;
        }

        .res-info { flex: 1; }

        .res-name {
            font-weight: bold;
            font-size: 15px;
            color: #3b5998;
            text-decoration: none;
        }

        .res-name:hover { text-decoration: underline; }

        .res-sub { color: #555; font-size: 12px; margin-top: 3px; }

        .empty-msg {
            text-align: center;
            color: #777;
            padding: 40px 0;
            font-size: 14px;
            font-style: italic;
        }
    </style>
</head>
<body>

<%- include('../partials/nav') %>

<div class="main-container">

    <div class="sidebar-left">
        <div class="nav-links-box">
            <ul>
                <li><a href="/profile">&laquo; My Profile</a></li>
                <li><a href="/feed">Feed</a></li>
            </ul>
        </div>
    </div>

    <div class="profile-container">
        <div class="profile-topbar">Search Results for "<%= query %>"</div>

        <div class="content-body">

            <% if (users.length === 0) { %>
                <div class="empty-msg">No users found matching your search.</div>
            <% } else { %>
                <p style="margin-bottom: 16px; color:#555;">
                    Found <strong><%= users.length %></strong> user<%= users.length !== 1 ? 's' : '' %>:
                </p>

                <% users.forEach(function(resUser) { %>
                <div class="search-card">
                    <a href="/profile/<%= resUser.username %>">
                        <% if (resUser.avatar) { %>
                            <img src="<%= resUser.avatar %>" alt="<%= resUser.username %>" class="res-avatar">
                        <% } else { %>
                            <div class="res-avatar-ph"><%= resUser.username.charAt(0).toUpperCase() %></div>
                        <% } %>
                    </a>

                    <div class="res-info">
                        <a href="/profile/<%= resUser.username %>" class="res-name">
                            <%= resUser.fullName || resUser.username %>
                        </a>
                        <% if (resUser.fullName) { %>
                        <div class="res-sub">@<%= resUser.username %></div>
                        <% } %>
                        <% if (resUser.college) { %>
                        <div class="res-sub">School: <%= resUser.college %></div>
                        <% } %>
                        <% if (resUser.residence) { %>
                        <div class="res-sub">Residence: <%= resUser.residence %></div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            <% } %>

        </div>
    </div>

</div>
</body>
</html>
