<%- include('../partials/header', { title: "Thefacebook | Directory" }) %>

    <div class="main-container"
        style="max-width: 1150px; margin: 30px auto; padding: 0 20px; display: flex; gap: 25px; font-family: 'Lucida Grande', sans-serif;">

        <div class="sidebar-left" style="width: 200px; flex-shrink: 0;">
            <div class="nav-links-box" style="border: 1px dashed #555555; padding: 12px; background: #fff;">
                <ul style="list-style: none; margin: 0; padding: 0;">
                    <li style="margin-bottom: 8px;"><a href="/profile" style="color: #5471b0; text-decoration: none;">My
                            Profile</a></li>
                </ul>
            </div>
        </div>

        <div class="profile-container" style="flex: 1; border: 2px solid #3b5998; background-color: #fff;">
            <div class="profile-topbar"
                style="background: #4c66a4; padding: 8px 15px; border-bottom: 1px solid #3b5998; color: #fff; font-size: 15px; font-weight: bold;">
                Thefacebook Users Directory
            </div>

            <div style="padding: 20px;">
                <p style="margin-bottom: 15px; font-size: 14px; font-weight: bold;">Browse all users registered on your
                    school network:</p>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px;">
                    <% if (typeof users !=='undefined' && users.length> 0) { %>
                        <% users.forEach(function(u) { %>
                            <div
                                style="border: 1px solid #3b5998; background: #f0f2f7; padding: 10px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; height: 160px;">
                                <div
                                    style="width: 65px; height: 65px; background: #e0e4f0; border: 1px solid #bcbcbc; margin: 0 auto 8px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <% if (u.avatar) { %>
                                        <img src="<%= u.avatar %>" alt="avatar"
                                            style="width: 100%; height: 100%; object-fit: cover;">
                                        <% } %>
                                </div>
                                <span
                                    style="font-weight: bold; color: #000; font-size: 12px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <%= u.fullName || u.username %>
                                </span>
                                <a href="/profile/<%= u.username || u._id %>"
                                    style="display: block; background: #5F8ACF; color: #fff; border: 1px solid #3a6ab0; font-size: 11px; padding: 4px 0; margin-top: 6px; text-decoration: none; font-weight: bold;">
                                    view profile
                                </a>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p style="grid-column: 1 / -1; font-style: italic; color: #777;">No users found on
                                        this server network instance.</p>
                                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>