<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="UTF-8">
    <title>Feed – thefacebook</title>
    <style>
        body.feed-page {
            background-color: #ffffff;
            font-family: "Lucida Grande", Tahoma, Verdana, Arial, sans-serif;
            color: #111;
            margin: 0;
            padding: 0;
        }

        .page-wrapper {
            display: flex;
            justify-content: center;
            padding: 30px 20px;
        }

        .feed-container {
            width: 100%;
            max-width: 650px;
        }

        .avatar-square {
            width: 48px;
            height: 48px;
            border-radius: 6px;
            object-fit: cover;
            border: 1px solid #ccc;
            flex-shrink: 0;
        }

        .avatar-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eceff5;
            color: #3b5998;
            font-weight: bold;
            font-size: 18px;
        }

        /* Composer */
        .composer-section {
            display: flex;
            gap: 15px;
            align-items: flex-start;
            margin-bottom: 25px;
        }

        .composer-card {
            background: #f2f2f2;
            padding: 12px;
            border: 1px solid #ccc;
            flex-grow: 1;
        }

        .composer-header-text {
            color: #777;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .composer-form {
            display: flex;
            gap: 8px;
        }

        .composer-textarea {
            flex-grow: 1;
            height: 32px;
            border: 1px solid #bdc7d8;
            padding: 5px 8px;
            font-family: inherit;
            font-size: 15px;
        }

        .share-btn {
            background: #3b5998;
            color: #fff;
            border: 1px solid #29447e;
            font-weight: bold;
            padding: 0 16px;
            font-size: 14px;
            cursor: pointer;
            height: 32px;
        }

        .share-btn:hover {
            background: #4c66a4;
        }

        /* Normal post */
        .post-card {
            display: flex;
            gap: 15px;
            padding: 18px 0;
        }

        .post-content-area {
            display: flex;
            flex-direction: column;
            font-size: 15px;
            line-height: 1.4;
        }

        .post-author-name {
            color: #3b5998;
            text-decoration: none;
            font-weight: bold;
            margin-right: 6px;
        }

        .post-author-name:hover {
            text-decoration: underline;
        }

        .post-meta {
            font-size: 12px;
            color: #777;
            margin-top: 4px;
        }

        .post-divider {
            border: 0;
            height: 1px;
            background: #e5e5e5;
            margin: 0;
        }

        /* Activity event — smaller */
        .activity-card {
            display: flex;
            gap: 10px;
            padding: 10px 0;
            align-items: center;
        }

        .activity-avatar {
            width: 30px;
            height: 30px;
            border-radius: 4px;
            object-fit: cover;
            border: 1px solid #ccc;
            flex-shrink: 0;
        }

        .activity-avatar-ph {
            width: 30px;
            height: 30px;
            border-radius: 4px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eceff5;
            color: #3b5998;
            font-weight: bold;
            font-size: 12px;
        }

        .activity-icon {
            width: 16px;
            height: 16px;
            opacity: 0.6;
            flex-shrink: 0;
        }

        .activity-text {
            font-size: 12px;
            color: #555;
            line-height: 1.4;
        }

        .activity-text a {
            color: #3b5998;
            text-decoration: none;
        }

        .activity-text a:hover {
            text-decoration: underline;
        }

        .activity-text strong {
            color: #222;
        }

        .activity-time {
            font-size: 11px;
            color: #999;
            margin-top: 2px;
        }

        .empty-feed {
            text-align: center;
            color: #777;
            padding: 30px 0;
            font-size: 15px;
        }

        /* Edit/Delete Actions */
        .post-card {
            position: relative;
        }

        .post-actions {
            position: absolute;
            top: 15px;
            right: 10px;
            display: none;
            gap: 8px;
        }

        .post-card:hover .post-actions {
            display: flex;
        }

        .action-icon {
            width: 14px;
            height: 14px;
            cursor: pointer;
            opacity: 0.5;
            transition: opacity 0.2s;
        }

        .action-icon:hover {
            opacity: 1;
        }

        .edit-form {
            display: none;
            margin-top: 8px;
            width: 100%;
        }

        .edit-input {
            width: 100%;
            border: 1px solid #bdc7d8;
            padding: 4px 6px;
            font-family: inherit;
            font-size: 14px;
            margin-bottom: 5px;
            box-sizing: border-box;
        }

        .edit-save-btn {
            background: #3b5998;
            color: #fff;
            border: 1px solid #29447e;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 8px;
            cursor: pointer;
        }

        .edit-cancel-btn {
            background: #f2f2f2;
            color: #333;
            border: 1px solid #ccc;
            font-size: 11px;
            padding: 2px 8px;
            cursor: pointer;
            margin-left: 5px;
        }

        /* Image Upload */
        .image-upload-label {
            cursor: pointer;
            display: flex;
            align-items: center;
            opacity: 0.7;
            transition: opacity 0.2s;
        }

        .image-upload-label:hover {
            opacity: 1;
        }

        .image-upload-icon {
            width: 20px;
            height: 20px;
        }

        .post-image {
            max-width: 100%;
            max-height: 400px;
            margin-top: 10px;
            border: 1px solid #ddd;
            display: block;
        }
    </style>
</head>

<body class="feed-page">

    <%- include('../partials/nav', { activePage: 'feed' }) %>

        <div class="page-wrapper">
            <div class="feed-container">

                <% if (locals.dbError) { %>
                    <div
                        style="margin-bottom:15px;padding:10px;background:#fff0f0;border:1px solid #ffcccc;color:#cc0000;">
                        <strong>⚠ Databáze není připojena.</strong>
                    </div>
                    <% } %>

                        <div class="composer-section">
                            <div>
                                <a href="/profile/<%= currentUser.username %>">
                                    <% if (currentUser && currentUser.avatar) { %>
                                        <img src="<%= currentUser.avatar %>" alt="Avatar" class="avatar-square">
                                        <% } else { %>
                                            <div class="avatar-square avatar-placeholder">
                                                <%= currentUser ? currentUser.username.charAt(0).toUpperCase() : '?' %>
                                            </div>
                                            <% } %>
                                </a>
                            </div>
                            <div class="composer-card">
                                <div class="composer-header-text">What's on your mind?</div>
                                <form action="/feed" method="POST" class="composer-form" enctype="multipart/form-data">
                                    <input type="text" name="content" class="composer-textarea" autocomplete="off" />
                                    <label class="image-upload-label" title="Přidat obrázek">
                                        <img src="/image-icon.svg" class="image-upload-icon" alt="">
                                        <input type="file" name="image" accept="image/*" style="display:none;">
                                    </label>
                                    <button type="submit" class="share-btn">Sdílet</button>
                                </form>
                            </div>
                        </div>

                        <div class="posts-list">
                            <% if (feedItems.length===0) { %>
                                <div class="empty-feed">
                                    <p>Zatím žádné příspěvky. Buď první!</p>
                                </div>
                                <% } %>

                                    <% feedItems.forEach((item, index)=> {
                                        const isLast = index === feedItems.length - 1;
                                        %>
                                        <% if (item.kind==='post' ) { const post=item.data; %>
                                            <div class="post-card" id="post-<%= post._id %>">
                                                <% if (currentUser && (post.author._id.toString() === currentUser._id.toString() || currentUser.role === 'admin')) { %>
                                                    <div class="post-actions">
                                                        <% if (post.author._id.toString() === currentUser._id.toString()) { %>
                                                            <img src="/edit.svg" class="action-icon" onclick="toggleEdit('<%= post._id %>')" title="Upravit">
                                                        <% } %>
                                                        <form action="/feed/<%= post._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Opravdu smazat?')">
                                                            <button type="submit" style="background:none; border:none; padding:0; cursor:pointer;">
                                                                <span style="color:#cc0000; font-weight:bold; font-size:16px; line-height:10px;">&times;</span>
                                                            </button>
                                                        </form>
                                                    </div>
                                                <% } %>
                                                <div style="flex-shrink:0;">
                                                    <a href="/profile/<%= post.author.username %>">
                                                        <% if (post.author.avatar) { %>
                                                            <img src="<%= post.author.avatar %>" alt="Avatar"
                                                                class="avatar-square">
                                                            <% } else { %>
                                                                <div class="avatar-square avatar-placeholder">
                                                                    <%= post.author.username.charAt(0).toUpperCase() %>
                                                                </div>
                                                                <% } %>
                                                    </a>
                                                </div>
                                                <div class="post-content-area" style="width: 100%;">
                                                    <div class="post-view-mode" id="view-<%= post._id %>">
                                                        <a href="/profile/<%= post.author.username %>"
                                                            class="post-author-name">
                                                            <%= post.author.fullName && post.author.fullName.trim() ?
                                                                post.author.fullName : post.author.username %>
                                                        </a>
                                                        <span class="post-text">
                                                            <%= post.content %>
                                                        </span>
                                                        <% if (post.image) { %>
                                                            <img src="<%= post.image %>" class="post-image" alt="">
                                                        <% } %>
                                                    </div>

                                                    <% if (currentUser && post.author._id.toString() === currentUser._id.toString()) { %>
                                                        <form action="/feed/<%= post._id %>?_method=PUT" method="POST" class="edit-form" id="edit-form-<%= post._id %>" enctype="multipart/form-data">
                                                            <input type="text" name="content" class="edit-input" value="<%= post.content %>" required>
                                                            <div style="display:flex; gap:10px; align-items:center; margin-bottom:5px;">
                                                                <label class="image-upload-label" title="Změnit obrázek">
                                                                    <img src="/image-icon.svg" class="image-upload-icon" alt="">
                                                                    <input type="file" name="image" accept="image/*" style="display:none;">
                                                                </label>
                                                                <button type="submit" class="edit-save-btn">Uložit</button>
                                                                <button type="button" class="edit-cancel-btn" onclick="toggleEdit('<%= post._id %>')">Zrušit</button>
                                                            </div>
                                                        </form>
                                                    <% } %>

                                                    <div class="post-meta">
                                                        <%= timeAgo(post.createdAt) %>
                                                    </div>
                                                </div>
                                            </div>

                                            <% } else { const ev=item.data; const actor=ev.actor; const meta=ev.meta ||
                                                {}; let iconSrc='/edit.svg' ; let activityHtml='' ; if
                                                (ev.type==='birthday_edit' ) { iconSrc='/calendar.svg' ;
                                                activityHtml=`<strong>${actor.fullName || actor.username}</strong>
                                                updated their Birthday to <strong>${meta.newValue}</strong>.`;
                                                } else if (ev.type === 'wall_post') {
                                                iconSrc = '/add-wall.svg';
                                                activityHtml = `<strong>${actor.fullName || actor.username}</strong>
                                                wrote on <a
                                                    href="/profile/${meta.wallTargetUsername}">${meta.wallTargetUsername}</a>'s
                                                wall.`;
                                                } else if (ev.type === 'friend_added') {
                                                iconSrc = '/add-friend.svg';
                                                activityHtml = `<strong>${actor.fullName || actor.username}</strong> and
                                                <a href="/profile/${meta.friendUsername}">${meta.friendUsername}</a> are
                                                now friends.`;
                                                } else {
                                                // profile_edit
                                                const label = FIELD_LABELS[meta.field] || meta.field;
                                                activityHtml = `<strong>${actor.fullName || actor.username}</strong>
                                                changed their ${label} to <strong>${meta.newValue}</strong>.`;
                                                }
                                                %>
                                                <div class="activity-card">
                                                    <img src="<%= iconSrc %>" class="activity-icon" alt="">
                                                    <div>
                                                        <div class="activity-text"><%- activityHtml %></div>
                                                        <div class="activity-time">
                                                            <%= timeAgo(ev.createdAt) %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <% if (!isLast) { %>
                                                        <hr class="post-divider">
                                                        <% } %>
                                                            <% }) %>
                        </div>

            </div>
        </div>

        <script>
            function toggleEdit(postId) {
                const viewDiv = document.getElementById('view-' + postId);
                const editForm = document.getElementById('edit-form-' + postId);

                if (viewDiv.style.display === 'none') {
                    viewDiv.style.display = 'block';
                    editForm.style.display = 'none';
                } else {
                    viewDiv.style.display = 'none';
                    editForm.style.display = 'block';
                    // Focus the input
                    editForm.querySelector('input').focus();
                }
            }
        </script>
</body>

</html>
